{
  "name": "sublink-worker",
  "version": "2.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-vercel.mjs",
    "deploy": "npm run setup-kv && wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "setup-kv": "node scripts/setup-kv.cjs",
    "build:node": "esbuild src/platforms/node-server.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/node-server.cjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "dev:node": "npm run build:node && node dist/node-server.cjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.8",
    "@perryts/hono-server": "^0.1.0",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "vitest": "^4.1.7",
    "wrangler": "^4.51.0"
  },
  "dependencies": {
    "esbuild-register": "^3.6.0",
    "hono": "^4.10.7",
    "ioredis": "^5.8.2",
    "js-yaml": "^4.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "perry": {
    "compilePackages": [
      "@perryts/hono-server",
      "hono",
      "js-yaml"
    ],
    "allow": {
      "compilePackages": [
        "@perryts/hono-server",
        "hono",
        "js-yaml"
      ]
    }
  }
}
